<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Skinki is intentionally NOT sandboxed: deep macOS integration
	  (Accessibility, input simulation, shell, Full Disk Access) is
	  incompatible with the App Store sandbox. Distributed via a notarized
	  .dmg with Hardened Runtime enabled. See ARCHITECTURE.md §6/§7.
	-->
	<key>com.apple.security.app-sandbox</key>
	<false/>

	<!-- Microphone access for native dictation / voice input. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>

	<!-- Hardened Runtime exceptions for the MLX/Metal inference runtime. -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>

	<!-- Control other apps (AppleEvents) for in-place text replacement / actions. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
